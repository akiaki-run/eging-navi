rules_version = '2';
// 全国エギングナビ:データの鍵(Firebase の Firestore → ルール に貼り付ける)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMember(code) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(code)/members/$(request.auth.uid));
    }

    // 自分の記録・ポイント・範囲:本人だけが読み書きできる
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // みんなの学習:釣行1回分の「釣り方・釣れた魚・条件の区分・水温・月・だいたいの地域(約50km四方)」だけ(正確な場所・日時・写真・メモは入れない)。
    // ログインした人は読める。書けるのは自分の分だけ。
    match /pool/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && id.matches(request.auth.uid + '_.*')
                            && request.resource.data.u == request.auth.uid
                            && request.resource.data.keys().hasOnly(['u','m','f','fc','hr','b','s','mo','ga','go'])
                            && request.resource.data.f is list && request.resource.data.f.size() <= 10
                            && request.resource.data.b is map && request.resource.data.b.size() <= 30
                            && request.resource.data.fc is map && request.resource.data.fc.size() <= 10;
      allow delete: if signedIn() && resource.data.u == request.auth.uid;
    }

    // 仲間グループ:コードを知っている人だけが参加でき、参加者だけが中を見られる
    match /groups/{code} {
      allow get: if signedIn();                       // コードで存在を確かめる
      allow list: if false;                           // 一覧は誰にも見せない
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid
                    && code.matches('^[a-z0-9]{10}$');

      match /members/{mid} {
        allow read: if isMember(code);
        allow create: if signedIn() && mid == request.auth.uid
                      && exists(/databases/$(database)/documents/groups/$(code));
        allow delete: if signedIn() && mid == request.auth.uid;
      }

      match /spots/{sid} {
        allow read: if isMember(code);
        allow create, update: if isMember(code)
                              && request.resource.data.by == request.auth.uid
                              && sid.matches(request.auth.uid + '_.*');
        allow delete: if isMember(code) && resource.data.by == request.auth.uid;
      }
    }
  }
}
